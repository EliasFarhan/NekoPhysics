{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "USE_SAMPLES": "ON",
        "USE_TESTING": "ON",
        "NEKO_SCALAR": "FIXED16",
        "NEKO_WARNINGS_AS_ERRORS": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug (samples + tests)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "debug-float",
      "displayName": "Debug, float Scalar (samples + tests)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "NEKO_SCALAR": "FLOAT" }
    },
    {
      "name": "debug-sixit",
      "displayName": "Debug, sixit deterministic float Scalar (samples + tests)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "NEKO_SCALAR": "SIXIT" }
    },
    {
      "name": "release",
      "displayName": "Release (samples + tests)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "release-sixit",
      "displayName": "Release, sixit deterministic float Scalar (samples + tests)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "NEKO_SCALAR": "SIXIT" }
    },
    {
      "name": "relwithdebinfo",
      "displayName": "RelWithDebInfo (samples + tests)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "nds",
      "displayName": "Nintendo DS test ROM (devkitARM, needs DEVKITPRO)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{DEVKITPRO}/cmake/NDS.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "USE_SAMPLES": "OFF",
        "USE_TESTING": "OFF",
        "NEKO_SCALAR": "FIXED16",
        "NEKO_WARNINGS_AS_ERRORS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "debug-float", "configurePreset": "debug-float" },
    { "name": "debug-sixit", "configurePreset": "debug-sixit" },
    { "name": "release", "configurePreset": "release" },
    { "name": "release-sixit", "configurePreset": "release-sixit" },
    { "name": "relwithdebinfo", "configurePreset": "relwithdebinfo" },
    { "name": "nds", "configurePreset": "nds" }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "debug-float",
      "configurePreset": "debug-float",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "debug-sixit",
      "configurePreset": "debug-sixit",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "release-sixit",
      "configurePreset": "release-sixit",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "relwithdebinfo",
      "configurePreset": "relwithdebinfo",
      "output": { "outputOnFailure": true }
    }
  ]
}
